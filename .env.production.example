# Production Environment Configuration for Life OS
# Domain: lifeos.nurikhsan.web.id

NODE_ENV=production
PORT=3010

# PostgreSQL Database Connection URL
DATABASE_URL="postgresql://lifeos_user:YOUR_STRONG_DB_PASSWORD@localhost:5432/lifeos_db?schema=public"

# Telegram Bot Credentials (Get from @BotFather)
TELEGRAM_BOT_TOKEN="123456789:ABCdefGHIjklMNOpqrsTUVwxyz"

# JWT Secret Key for User Session Tokens
JWT_SECRET="your_very_secret_jwt_key_here_change_this"

# Frontend Public API URL (Domain VPS)
NEXT_PUBLIC_API_URL="https://lifeos.nurikhsan.web.id"
