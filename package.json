{
  "name": "lifeos-backend",
  "version": "1.0.0",
  "description": "Backend API and Telegram Bot for Life OS",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "web:dev": "next dev -p 3011",
    "build": "tsc -p tsconfig.server.json && next build",
    "start": "node dist/server.js",
    "web:start": "next start -p 3011",
